<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
    <div class="admin-container">
        <!-- Top Navbar -->
        <header class="admin-navbar">
            <div>
                <h1 style="font-size: 1.35rem; font-weight: 800; color: var(--text-main);">
                    🏢 QL PHÒNG TRỌ <span style="color: var(--primary-color);">PRO</span>
                </h1>
                <p style="font-size: 0.85rem; color: var(--text-muted); margin: 0;">
                    Kỳ thanh toán: Tháng <%= currentMonth %>/<%= currentYear %> | Xin chào, <strong><%= user.fullName %></strong>
                </p>
            </div>
            <nav class="admin-nav-links">
                <a href="/admin/dashboard" class="admin-nav-link active">Dashboard</a>
                <a href="/admin/rooms" class="admin-nav-link">Quản Lý Phòng</a>
                <a href="/admin/invoices" class="admin-nav-link">Hóa Đơn</a>
                <a href="/admin/logout" class="btn-logout" style="background: #fee2e2; color: #b91c1c; text-decoration: none; padding: 6px 14px; border-radius: 6px; font-weight: 600; font-size: 0.85rem;">
                    Đăng xuất 🚪
                </a>
            </nav>
        </header>

        <!-- Thông báo trạng thái Telegram nếu có -->
        <% if (tg_status === 'success') { %>
            <div class="notice-box notice-paid" style="margin-bottom: 20px;">
                ✅ <strong>Đã gửi tin nhắn test Telegram thành công!</strong> Hãy kiểm tra ứng dụng Telegram của bạn.
            </div>
        <% } else if (tg_status === 'failed') { %>
            <div class="alert-error" style="margin-bottom: 20px;">
                ❌ <strong>Gửi tin nhắn Telegram thất bại!</strong> Vui lòng kiểm tra lại <code>TELEGRAM_BOT_TOKEN</code> và <code>ADMIN_TELEGRAM_CHAT_ID</code>.
            </div>
        <% } else if (tg_status === 'webhook_success') { %>
            <div class="notice-box notice-paid" style="margin-bottom: 20px;">
                🔗 <strong>Đã kích hoạt Webhook Telegram thành công!</strong> Giờ đây bot có thể nhận tin nhắn <code>/start</code>.
            </div>
        <% } else if (tg_status === 'no_chat_id') { %>
            <div class="alert-error" style="margin-bottom: 20px;">
                ⚠️ <strong>Chưa cấu hình ADMIN_TELEGRAM_CHAT_ID!</strong> Hãy nhắn tin <code>/start</code> cho bot để lấy Chat ID.
            </div>
        <% } %>

        <!-- SECTION 1: KPI CARDS -->
        <section class="kpi-grid">
            <div class="kpi-card">
                <span class="kpi-label">🏠 TỔNG PHÒNG TRỌ</span>
                <span class="kpi-value"><%= roomStats.total_rooms %></span>
                <span style="font-size: 0.8rem; color: var(--text-muted);">
                    Đang thuê: <strong style="color: var(--success-color);"><%= roomStats.occupied_rooms %></strong> | Trống: <strong style="color: var(--primary-color);"><%= roomStats.vacant_rooms %></strong>
                </span>
            </div>

            <div class="kpi-card">
                <span class="kpi-label">💰 ĐÃ THU (THÁNG <%= currentMonth %>/<%= currentYear %>)</span>
                <span class="kpi-value" style="color: var(--success-color);"><%= formatCurrency(invoiceStats.total_collected) %></span>
                <span style="font-size: 0.8rem; color: var(--text-muted);">Số tiền khách đã chuyển khoản thành công</span>
            </div>

            <div class="kpi-card">
                <span class="kpi-label">⏳ CHƯA THU / CÔNG NỢ</span>
                <span class="kpi-value" style="color: var(--danger-color);"><%= formatCurrency(invoiceStats.total_uncollected) %></span>
                <span style="font-size: 0.8rem; color: var(--text-muted);">Bao gồm hóa đơn chưa trả & đang chờ</span>
            </div>

            <div class="kpi-card">
                <span class="kpi-label">🔔 CHỜ DUYỆT THANH TOÁN</span>
                <span class="kpi-value" style="color: var(--warning-color);"><%= invoiceStats.pending_count %></span>
                <span style="font-size: 0.8rem; color: var(--text-muted);">
                    Quá hạn: <strong style="color: #be185d;"><%= invoiceStats.overdue_count %></strong>
                </span>
            </div>
        </section>

        <!-- SECTION 2: BIỂU ĐỒ DOANH THU & CƠ CẤU CHI PHÍ -->
        <section class="chart-grid">
            <div class="chart-card">
                <h3 style="font-size: 1rem; font-weight: 700; margin-bottom: 14px; color: var(--text-main);">
                    📊 Doanh Thu Theo Tháng (VNĐ)
                </h3>
                <canvas id="revenueChart" height="200"></canvas>
            </div>

            <div class="chart-card">
                <h3 style="font-size: 1rem; font-weight: 700; margin-bottom: 14px; color: var(--text-main);">
                    🥧 Cơ Cấu Doanh Thu Tháng <%= currentMonth %>/<%= currentYear %>
                </h3>
                <canvas id="feeChart" height="200"></canvas>
            </div>
        </section>

        <!-- SECTION 3: THANH TOÁN ĐANG CHỜ XÁC NHẬN (PENDING) -->
        <% const pendingRooms = rooms.filter(r => r.invoice_status === 'PENDING'); %>
        <% if (pendingRooms.length > 0) { %>
        <section style="margin-bottom: 24px;">
            <div style="font-size: 1.1rem; font-weight: 800; color: #b45309; margin-bottom: 12px; display: flex; align-items: center; gap: 8px;">
                <span>🟡</span> CÁC PHÒNG ĐANG CHỜ DUYỆT CHUYỂN KHOẢN (<%= pendingRooms.length %>)
            </div>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 14px;">
                <% pendingRooms.forEach(p => { %>
                <div class="card" style="border: 2px solid #fde68a; background-color: #fffbeb;">
                    <div class="room-card-header">
                        <span class="room-name"><%= p.room_number %></span>
                        <span class="status-badge status-pending">🟡 Chờ xác nhận</span>
                    </div>

                    <div style="margin: 10px 0;">
                        <span style="color: var(--text-muted); font-size: 0.9rem;">Số tiền khách báo đã chuyển:</span>
                        <div style="font-size: 1.35rem; font-weight: 800; color: var(--primary-color);">
                            <%= formatCurrency(p.total_amount) %>
                        </div>
                    </div>

                    <div style="display: flex; gap: 8px; margin-top: 8px;">
                        <form method="POST" action="/admin/payment/<%= p.invoice_id %>/approve" style="flex: 2;">
                            <button type="submit" class="btn btn-success" style="padding: 10px; font-size: 0.9rem;">
                                ✅ XÁC NHẬN ĐÃ NHẬN TIỀN
                            </button>
                        </form>
                        <form method="POST" action="/admin/payment/<%= p.invoice_id %>/reset" style="flex: 1;" onsubmit="return confirm('Reset hóa đơn <%= p.room_number %> về trạng thái Chưa thanh toán?');">
                            <button type="submit" class="btn btn-outline-danger" style="padding: 10px; font-size: 0.9rem;">
                                🔄 Reset
                            </button>
                        </form>
                    </div>
                </div>
                <% }); %>
            </div>
        </section>
        <% } %>

        <!-- SECTION 4: DANH SÁCH TẤT CẢ CÁC PHÒNG & CHUYỂN ĐỔI NHANH 3 TRẠNG THÁI -->
        <section style="margin-bottom: 30px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                <h2 style="font-size: 1.15rem; font-weight: 800; color: var(--text-main);">
                    📋 DANH SÁCH PHÒNG & HÓA ĐƠN THÁNG <%= currentMonth %>/<%= currentYear %>
                </h2>
                <a href="/admin/rooms" class="btn btn-primary" style="width: auto; padding: 8px 16px; font-size: 0.85rem;">
                    + Quản Lý Phòng
                </a>
            </div>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 16px;">
                <% rooms.forEach(room => { %>
                <div class="room-card">
                    <div class="room-card-header">
                        <span class="room-name"><%= room.room_number %></span>
                        <% if (room.invoice_status === 'UNPAID') { %>
                            <span class="status-badge status-unpaid">🔴 Chưa thanh toán</span>
                        <% } else if (room.invoice_status === 'PENDING') { %>
                            <span class="status-badge status-pending">🟡 Đang chờ duyệt</span>
                        <% } else if (room.invoice_status === 'PAID') { %>
                            <span class="status-badge status-paid">🟢 Đã thanh toán</span>
                        <% } else if (room.invoice_status === 'OVERDUE') { %>
                            <span class="status-badge status-overdue">🟣 Quá hạn</span>
                        <% } else { %>
                            <span class="status-badge status-unpaid">Chưa lập HĐ</span>
                        <% } %>
                    </div>

                    <!-- Bảng kê tiền phòng -->
                    <div class="admin-fee-details">
                        <div class="fee-item">
                            <span class="fee-label">Tiền phòng:</span>
                            <span class="fee-value"><%= formatCurrency(room.room_fee || room.base_price) %></span>
                        </div>
                        <div class="fee-item">
                            <span class="fee-label">Tiền điện:</span>
                            <span class="fee-value">
                                <%= formatCurrency(room.electricity_fee || 0) %>
                                <% if (room.electricity_units) { %>
                                    <small style="color: var(--text-muted);">(<%= room.electricity_units %> số)</small>
                                <% } %>
                            </span>
                        </div>
                        <div class="fee-item">
                            <span class="fee-label">Tiền nước:</span>
                            <span class="fee-value"><%= formatCurrency(room.water_fee || 0) %></span>
                        </div>
                        <div class="fee-item fee-total">
                            <span class="fee-label" style="font-weight: 700;">TỔNG CỘNG:</span>
                            <span class="fee-value" style="font-size: 1.15rem; color: var(--primary-color); font-weight: 800;">
                                <%= formatCurrency(room.total_amount || room.base_price) %>
                            </span>
                        </div>
                    </div>

                    <!-- 1-Click Status Switcher (3 Chế độ: UNPAID, PENDING, PAID) -->
                    <% if (room.invoice_id) { %>
                    <form method="POST" action="/admin/invoices/<%= room.invoice_id %>/set-status" style="margin-top: 4px;">
                        <div style="display: flex; align-items: center; justify-content: space-between; background: #f1f5f9; padding: 6px 10px; border-radius: 8px;">
                            <span style="font-size: 0.85rem; font-weight: 700; color: var(--text-muted);">Đổi chế độ:</span>
                            <select name="status" class="form-input" style="width: auto; padding: 5px 8px; font-size: 0.85rem; font-weight: 700; background: #fff; cursor: pointer; border-radius: 6px;" onchange="this.form.submit()">
                                <option value="UNPAID" <%= room.invoice_status === 'UNPAID' ? 'selected' : '' %>>🔴 Chưa thanh toán</option>
                                <option value="PENDING" <%= room.invoice_status === 'PENDING' ? 'selected' : '' %>>🟡 Đang chờ duyệt</option>
                                <option value="PAID" <%= room.invoice_status === 'PAID' ? 'selected' : '' %>>🟢 Đã thanh toán</option>
                                <option value="OVERDUE" <%= room.invoice_status === 'OVERDUE' ? 'selected' : '' %>>🟣 Quá hạn</option>
                            </select>
                        </div>
                    </form>
                    <% } %>

                    <!-- Nút cập nhật hóa đơn & trạng thái chi tiết -->
                    <div style="display: flex; gap: 8px; margin-top: 6px;">
                        <a href="/admin/room/<%= room.room_id %>" class="btn btn-primary" style="padding: 10px; font-size: 0.9rem; flex: 1;">
                            ✏️ Cập nhật hóa đơn
                        </a>
                        <% if (room.invoice_id) { %>
                        <a href="/invoice/<%= room.invoice_id %>" target="_blank" class="btn btn-outline-danger" style="color: #475569; border-color: #cbd5e1; padding: 10px; font-size: 0.9rem; width: auto;" title="Xem hóa đơn khách">
                            👁️
                        </a>
                        <% } %>
                    </div>
                </div>
                <% }); %>
            </div>
        </section>

        <!-- SECTION 5: CÔNG CỤ TELEGRAM BOT -->
        <section class="card" style="background-color: #f8fafc; border: 1px dashed var(--border-color); margin-bottom: 24px;">
            <div style="font-weight: 700; font-size: 1rem; margin-bottom: 6px; display: flex; align-items: center; gap: 6px;">
                <span>🤖</span> CÔNG CỤ TELEGRAM BOT THÔNG BÁO TỨC THÌ
            </div>
            <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 14px;">
                Bot tự động gửi tin nhắn báo tiền về cho chủ trọ mỗi khi khách bấm "Tôi đã chuyển khoản". Hỗ trợ lệnh <code>/start</code> lấy Chat ID tự động.
            </p>
            <div style="display: flex; flex-wrap: wrap; gap: 10px;">
                <form method="POST" action="/admin/set-telegram-webhook">
                    <button type="submit" class="btn btn-primary" style="width: auto; padding: 9px 16px; font-size: 0.85rem; background-color: #6366f1;">
                        🔗 Kích hoạt Webhook (để nhận /start)
                    </button>
                </form>
                <form method="POST" action="/admin/test-telegram">
                    <button type="submit" class="btn btn-primary" style="width: auto; padding: 9px 16px; font-size: 0.85rem; background-color: #0284c7;">
                        📨 Gửi tin nhắn Test kết nối Bot
                    </button>
                </form>
            </div>
        </section>

        <footer class="footer">
            <a href="/">🏠 Xem giao diện người thuê</a>
        </footer>
    </div>

    <!-- Script vẽ biểu đồ Chart.js từ dữ liệu MySQL thực tế -->
    <script>
        const monthlyData = <%- monthlyRevenue %>;
        const feeData = <%- feeBreakdown %>;

        // 1. Biểu đồ doanh thu theo tháng
        const revCtx = document.getElementById('revenueChart').getContext('2d');
        new Chart(revCtx, {
            type: 'bar',
            data: {
                labels: monthlyData.length ? monthlyData.map(d => `Tháng ${d.payment_month}/${d.payment_year}`) : ['Tháng <%= currentMonth %>/<%= currentYear %>'],
                datasets: [{
                    label: 'Doanh thu đã thu (VNĐ)',
                    data: monthlyData.length ? monthlyData.map(d => d.revenue) : [<%= invoiceStats.total_collected %>],
                    backgroundColor: '#2563eb',
                    borderRadius: 6
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: value => new Intl.NumberFormat('vi-VN').format(value) + 'đ'
                        }
                    }
                }
            }
        });

        // 2. Biểu đồ cơ cấu chi phí
        const feeCtx = document.getElementById('feeChart').getContext('2d');
        new Chart(feeCtx, {
            type: 'doughnut',
            data: {
                labels: ['Tiền phòng', 'Tiền điện', 'Tiền nước'],
                datasets: [{
                    data: [
                        feeData ? feeData.total_room_fee : 0,
                        feeData ? feeData.total_electricity_fee : 0,
                        feeData ? feeData.total_water_fee : 0
                    ],
                    backgroundColor: ['#2563eb', '#f59e0b', '#06b6d4'],
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { position: 'bottom' }
                }
            }
        });
    </script>
</body>
</html>
