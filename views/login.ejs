<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - QLPhongTro PRO</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        <div class="card" style="margin-top: 40px;">
            <div style="text-align: center; margin-bottom: 20px;">
                <div style="font-size: 2.5rem; margin-bottom: 6px;">🏠</div>
                <h1 style="font-size: 1.35rem; font-weight: 800; color: var(--text-main);">QL PHÒNG TRỌ PRO</h1>
                <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 4px;">Đăng nhập khách thuê để xem hóa đơn & thanh toán</p>
            </div>

            <% if (error) { %>
            <div class="alert-error">
                <%= error %>
            </div>
            <% } %>

            <form method="POST" action="/login">
                <div class="form-group">
                    <label for="username" class="form-label">Tên đăng nhập (Phòng):</label>
                    <input type="text" id="username" name="username" class="form-input" 
                           placeholder="Ví dụ: phong1" required autofocus autocomplete="username">
                </div>

                <div class="form-group">
                    <label for="password" class="form-label">Mật khẩu:</label>
                    <input type="password" id="password" name="password" class="form-input" 
                           placeholder="Mật khẩu của phòng" required autocomplete="current-password">
                </div>

                <button type="submit" class="btn btn-primary" style="margin-top: 10px; font-size: 1.05rem; padding: 13px;">
                    ĐĂNG NHẬP ➔
                </button>
            </form>

            <div style="margin-top: 18px; padding-top: 14px; border-top: 1px dashed var(--border-color); font-size: 0.8rem; color: var(--text-muted); text-align: center;">
                💡 <em>Tài khoản mẫu: Tên đăng nhập <code>phong1</code> / Mật khẩu <code>phong123</code></em>
            </div>
        </div>

        <footer class="footer">
            <a href="/admin/login">🔐 Dành cho Quản trị viên (Admin Login)</a>
        </footer>
    </div>
</body>
</html>
